# Copy this file to web/.env.local and fill in the values there. Never put a real key in THIS file:
# it is committed to git. Only server code (web/api/ai.js) reads these; never prefix them with VITE_.
# On Vercel, add the same 3 names in Settings -> Environment Variables, then Redeploy.
#
# Example values for Groq (not secrets):
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=openai/gpt-oss-120b
#   AI_API_KEY=  <- your own key from console.groq.com/keys, only in .env.local
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
